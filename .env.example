# Copy this file to .env for local development.
# In Vercel, add DATABASE_URL, YOCO_SECRET_KEY, YOCO_WEBHOOK_SECRET, SITE_URL,
# EMAIL_ASSET_BASE_URL, and the Resend email variables.
DATABASE_URL=postgres://user:password@host:5432/everythinghooked
SITE_URL=http://localhost:8080
EMAIL_ASSET_BASE_URL=https://everythinghooked.online
VITE_API_URL=http://localhost:3002
YOCO_SECRET_KEY=sk_test_your_yoco_secret_key
YOCO_WEBHOOK_SECRET=whsec_your_yoco_webhook_secret
RESEND_API_KEY=re_your_resend_api_key
ORDER_EMAIL_FROM=EverythingHooked <orders@everythinghooked.online>
ORDER_EMAIL_REPLY_TO=everythinghooked09@gmail.com
